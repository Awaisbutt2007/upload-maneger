# Public address of the app; OAuth callbacks become <PUBLIC_URL>/api/<platform>/oauth/callback
PUBLIC_URL=http://localhost:3001
API_PORT=4001
MAX_UPLOAD_MB=512

# TikTok — Login Kit + Content Posting API (scopes: user.info.basic, video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta — one app for Facebook Page + Instagram professional account (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# Google — YouTube Data API v3 OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn — "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" products
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601

# X — OAuth 2.0 app (confidential client) with media.write
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional per-platform redirect URI overrides, e.g.
# TIKTOK_REDIRECT_URI=https://example.com/api/tiktok/oauth/callback
