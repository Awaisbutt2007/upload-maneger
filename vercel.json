{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/keep-alive", "schedule": "0 4 * * *" }
  ]
}
